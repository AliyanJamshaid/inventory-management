# ==============================================
# INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and update with your values
# Never commit .env files to version control!

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Node environment (development, production, test)
NODE_ENV=development

# Application ports
BACKEND_PORT=5000
FRONTEND_PORT=3000

# ==============================================
# MONGODB DATABASE SETTINGS
# ==============================================

# MongoDB Connection
# Format: mongodb://username:password@host:port/database
MONGODB_URI=mongodb://admin:password123@localhost:27017/inventory_db?authSource=admin

# MongoDB Credentials (for Docker)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DB_NAME=inventory_db

# ==============================================
# MONGO EXPRESS (Database UI)
# ==============================================

# Web interface credentials for Mongo Express
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin123

# ==============================================
# JWT & AUTHENTICATION
# ==============================================

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT Token Expiration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# SESSION SETTINGS
# ==============================================

# Session Secret - CHANGE THIS IN PRODUCTION!
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Session Cookie Settings
SESSION_MAX_AGE=604800000
# 7 days in milliseconds

# ==============================================
# CORS SETTINGS
# ==============================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# ==============================================
# API SETTINGS
# ==============================================

# API Base URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# API Version
API_VERSION=v1

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================

# Maximum file upload size (in bytes)
MAX_FILE_SIZE=5242880
# 5MB in bytes

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Upload directory
UPLOAD_DIR=uploads

# ==============================================
# EMAIL SETTINGS (Optional - for notifications)
# ==============================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email From Address
EMAIL_FROM=noreply@inventory-system.com

# ==============================================
# LOGGING SETTINGS
# ==============================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log Directory
LOG_DIR=logs

# ==============================================
# RATE LIMITING
# ==============================================

# Maximum requests per window
RATE_LIMIT_MAX=100

# Time window in minutes
RATE_LIMIT_WINDOW=15

# ==============================================
# PAGINATION
# ==============================================

# Default page size
DEFAULT_PAGE_SIZE=20

# Maximum page size
MAX_PAGE_SIZE=100

# ==============================================
# CACHE SETTINGS (Optional - Redis)
# ==============================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600

# ==============================================
# FRONTEND SETTINGS (Next.js)
# ==============================================

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Name
NEXT_PUBLIC_SITE_NAME=Inventory Management System

# Enable Analytics (true/false)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ==============================================
# FEATURE FLAGS
# ==============================================

# Enable/Disable Features
FEATURE_NOTIFICATIONS=true
FEATURE_EXPORT=true
FEATURE_BULK_OPERATIONS=true
FEATURE_ADVANCED_SEARCH=true

# ==============================================
# SECURITY SETTINGS
# ==============================================

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_UPPERCASE=true
REQUIRE_PASSWORD_LOWERCASE=true
REQUIRE_PASSWORD_NUMBER=true
REQUIRE_PASSWORD_SPECIAL=true

# Account Lockout (after failed login attempts)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
# 15 minutes in milliseconds

# ==============================================
# TIMEZONE
# ==============================================

# Application timezone
TZ=UTC

# ==============================================
# BACKUP SETTINGS (Optional)
# ==============================================

# Backup directory
BACKUP_DIR=backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================

# Enable debug mode
DEBUG=false

# Enable API documentation
ENABLE_API_DOCS=true

# Seed database on startup (development only)
SEED_DATABASE=false
